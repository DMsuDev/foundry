#pragma once

#include <cstdint>
#include <string_view>

/**
 * @file version.h
 * @brief Foundry semantic version information (compile-time and runtime).
 *
 * Foundry follows Semantic Versioning (MAJOR.MINOR.PATCH):
 *  - MAJOR: breaking API changes.
 *  - MINOR: backwards-compatible features.
 *  - PATCH: backwards-compatible bug fixes.
 *
 * Two equivalent APIs are provided:
 *  - Preprocessor macros (`FOUNDRY_VERSION_*`), for use inside `#if` directives.
 *  - The `foundry::version` namespace, preferred everywhere else in C++ code.
 */

// ============================================================================
// GENERATED FILE - DO NOT EDIT.
// ----------------------------------------------------------------------------
// This header is generated by CMake via configure_file() from version.h.in.
// The version is defined exclusively in the root `VERSION` file.
//
// To bump the version, edit only that file; do not edit this generated
// header directly.
// ============================================================================

// ============================================================================
// Preprocessor API
// ============================================================================

/// @def FOUNDRY_VERSION_MAJOR
/// @brief Major version component (breaking changes).
#define FOUNDRY_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/// @def FOUNDRY_VERSION_MINOR
/// @brief Minor version component (backwards-compatible features).
#define FOUNDRY_VERSION_MINOR @PROJECT_VERSION_MINOR@

/// @def FOUNDRY_VERSION_PATCH
/// @brief Patch version component (backwards-compatible bug fixes).
#define FOUNDRY_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// @def FOUNDRY_VERSION_STRING
/// @brief Human-readable version string, e.g. "1.2.3".
#define FOUNDRY_VERSION_STRING "@PROJECT_VERSION@"

/// @def FOUNDRY_VERSION_FULL
/// @brief Full version string including any prerelease suffix, e.g. "1.2.0-WIP".
#define FOUNDRY_VERSION_FULL "@FOUNDRY_VERSION@"

/// @def FOUNDRY_VERSION_ENCODE(major, minor, patch)
/// @brief Packs a MAJOR.MINOR.PATCH triplet into a single comparable integer.
/// @details Encoding: major*10000 + minor*100 + patch (e.g. 1.2.3 -> 10203).
#define FOUNDRY_VERSION_ENCODE(major, minor, patch) \
    (((major) * 10000u) + ((minor) * 100u) + (patch))

/// @def FOUNDRY_VERSION
/// @brief The current Foundry version, packed via ::FOUNDRY_VERSION_ENCODE.
#define FOUNDRY_VERSION \
    FOUNDRY_VERSION_ENCODE( \
        FOUNDRY_VERSION_MAJOR, \
        FOUNDRY_VERSION_MINOR, \
        FOUNDRY_VERSION_PATCH)

/// @def FOUNDRY_VERSION_AT_LEAST(major, minor, patch)
/// @brief Compile-time gate: true if the current version is >= the given one.
/// @par Example
/// @code
/// #if FOUNDRY_VERSION_AT_LEAST(1, 2, 0)
///     // ...
/// #endif
/// @endcode
#define FOUNDRY_VERSION_AT_LEAST(major, minor, patch) \
    (FOUNDRY_VERSION >= FOUNDRY_VERSION_ENCODE((major), (minor), (patch)))

// ============================================================================
// Modern C++ API
// ============================================================================

namespace foundry::version {

/// @brief Major version component (breaking changes).
inline constexpr std::uint32_t major = FOUNDRY_VERSION_MAJOR;

/// @brief Minor version component (backwards-compatible features).
inline constexpr std::uint32_t minor = FOUNDRY_VERSION_MINOR;

/// @brief Patch version component (backwards-compatible bug fixes).
inline constexpr std::uint32_t patch = FOUNDRY_VERSION_PATCH;

/// @brief Packed version number (e.g. 1.2.3 -> 10203).
inline constexpr std::uint32_t value = FOUNDRY_VERSION;

/// @brief Human-readable version string (e.g. "1.2.3").
inline constexpr std::string_view string = FOUNDRY_VERSION_STRING;

/// @brief Full version string including any prerelease suffix (e.g. "1.2.0-WIP").
inline constexpr std::string_view full_string = FOUNDRY_VERSION_FULL;

/// @brief True when this build is a prerelease version.
inline constexpr bool is_prerelease =
#ifdef FOUNDRY_IS_PRERELEASE
    true;
#else
    false;
#endif // FOUNDRY_IS_PRERELEASE

/**
 * @brief Encodes a semantic version triplet into Foundry's packed integer format.
 * @param major Major version component.
 * @param minor Minor version component.
 * @param patch Patch version component.
 * @return Packed integer: major*10000 + minor*100 + patch.
 *
 * @par Example
 * @code
 * encode(1, 2, 3) == 10203;
 * @endcode
 */
[[nodiscard]] constexpr std::uint32_t encode(
    std::uint32_t major_version,
    std::uint32_t minor_version,
    std::uint32_t patch_version) noexcept
{
    return FOUNDRY_VERSION_ENCODE(major_version, minor_version, patch_version);
}

/**
 * @brief Checks whether the current Foundry version is >= the given version.
 * @param major Minimum required major version.
 * @param minor Minimum required minor version.
 * @param patch Minimum required patch version.
 * @return true if `value >= encode(major, minor, patch)`.
 *
 * @par Example
 * @code
 * if constexpr (foundry::version::at_least(1, 1, 0)) {
 *     // ...
 * }
 * @endcode
 */
[[nodiscard]] constexpr bool at_least(
    std::uint32_t major_version,
    std::uint32_t minor_version,
    std::uint32_t patch_version) noexcept
{
    return value >= encode(major_version, minor_version, patch_version);
}

} // namespace foundry::version
